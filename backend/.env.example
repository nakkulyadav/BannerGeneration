# SerpAPI Key — get yours at https://serpapi.com
# Free tier: 100 searches per month
SERPAPI_KEY=your_serpapi_key_here

# Remove.bg API Key — get yours at https://www.remove.bg/api
# Free tier: 50 API calls per month
REMOVE_BG_API_KEY=your_removebg_api_key_here

# Cloudinary Credentials — get yours at https://cloudinary.com
# Free tier: 25 credits per month for image transformations
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Server port
PORT=5000
